{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TheStreamCode/copilot-byok-switcher/main/schemas/providers.schema.json",
  "title": "Copilot BYOK Switcher providers",
  "type": "object",
  "required": [
    "providers"
  ],
  "properties": {
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "envName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "envNames": {
      "oneOf": [
        {
          "$ref": "#/$defs/envName"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/envName"
          }
        }
      ]
    },
    "stringPrefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provider": {
      "type": "object",
      "required": [
        "name",
        "baseUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "type": {
          "enum": [
            "openai",
            "anthropic",
            "azure"
          ]
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "authRequired": {
          "type": "boolean"
        },
        "apiKeyEnv": {
          "$ref": "#/$defs/envNames"
        },
        "bearerTokenEnv": {
          "$ref": "#/$defs/envNames"
        },
        "apiKeyCommand": {
          "type": "string",
          "minLength": 1,
          "description": "Command the Copilot CLI runs to obtain a fresh credential (legacy mode, COPILOT_PROVIDER_API_KEY_COMMAND). It is passed through, never executed by this tool."
        },
        "modelsUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "modelsAuth": {
          "enum": [
            true,
            false,
            "none",
            "bearer",
            "x-api-key",
            "api-key"
          ]
        },
        "modelsHeaders": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "modelsTimeoutMs": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300000
        },
        "catalogModelId": {
          "type": "string",
          "minLength": 1
        },
        "defaultModel": {
          "type": "string",
          "minLength": 1
        },
        "modelIncludePrefixes": {
          "$ref": "#/$defs/stringPrefixes"
        },
        "modelExcludePrefixes": {
          "$ref": "#/$defs/stringPrefixes"
        },
        "wireApi": {
          "enum": [
            "completions",
            "responses"
          ]
        },
        "transport": {
          "enum": [
            "http",
            "websockets"
          ]
        },
        "azureApiVersion": {
          "type": "string",
          "minLength": 1
        },
        "maxPromptTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "requireToolSupport": {
          "type": "boolean"
        },
        "models": {
          "type": "array",
          "description": "Optional pinned models published to the /model picker. When absent or empty, models come from live discovery.",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/model"
              }
            ]
          }
        },
        "enabled": {
          "type": "boolean",
          "description": "false keeps the provider in the catalog without activating it (useful for local runtimes)."
        },
        "headers": {
          "type": "object",
          "description": "Extra headers sent to the provider, for example for a company gateway.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "reasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "Default reasoning effort for every model of this provider; a model-level value wins."
        },
        "discover": {
          "type": "boolean",
          "description": "false disables asking this provider for its live model list."
        },
        "maxDiscoveredModels": {
          "type": "integer",
          "minimum": 1,
          "description": "How many discovered models this provider may contribute (default 12)."
        },
        "reasoningEffortPicker": {
          "type": "boolean",
          "description": "Default for every model of this provider; a model-level value wins."
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "anthropic"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "wireApi"
              ]
            }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Model name as the provider knows it."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Label shown in the Copilot /model picker."
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 1,
          "description": "Context window in tokens."
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum output tokens."
        },
        "reasoning": {
          "type": "boolean",
          "description": "Whether the model reasons before answering."
        },
        "vision": {
          "type": "boolean"
        },
        "reasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "Reasoning effort the router applies when the request carries none. Current Copilot CLIs forward the level picked in the selector on their own; this value remains useful on older CLIs or to pin a model to a fixed level. Ignored by --native-byok, which sends the CLI's level directly. Levels differ per model; an unsupported one is stepped down automatically in router mode."
        },
        "family": {
          "type": "string",
          "description": "Well-known model family, used by Copilot for model-specific handling."
        },
        "reasoningEffortPicker": {
          "type": "boolean",
          "description": "Declares reasoning-effort support so Copilot shows its effort selector. On by default for models that report reasoning, since current CLIs forward the level to BYOK providers. Set it to false to hide the selector; on CLI 1.0.79 the selector was inert."
        },
        "reasoningEffortLevels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          },
          "description": "Levels offered in the selector. Defaults to low/medium/high; models differ, so override where needed. In --native-byok this is the only lever, because the router's step-down does not apply."
        }
      },
      "additionalProperties": true
    }
  }
}
